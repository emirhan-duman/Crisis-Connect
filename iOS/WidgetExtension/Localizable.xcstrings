    "WIDGET_DISASTERS_DESC" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحدث الزلازل والكوارث القريبة منك على الشاشة الرئيسية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কাছের সাম্প্রতিক ভূমিকম্প ও দুর্যোগ হোম স্ক্রিনে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Erdbeben und Katastrophen in deiner Nähe auf dem Startbildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latest earthquakes and disasters near you, on your home screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los últimos terremotos y desastres cerca de ti, en tu pantalla de inicio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخرین زلزله‌ها و بلایای نزدیک شما در صفحه اصلی."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinakabagong lindol at sakuna malapit sa iyo, sa home screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les derniers séismes et catastrophes près de chez vous, sur l'écran d'accueil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके आस-पास के ताज़ा भूकंप और आपदाएँ, होम स्क्रीन पर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gempa dan bencana terbaru di sekitar Anda, di layar utama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの最新の地震・災害をホーム画面に表示します。"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erdhej û karesatên dawî yên nêzîkî te, li ser ekrana sereke."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os últimos terremotos e desastres perto de você, na tela inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние землетрясения и бедствия рядом с вами — на главном экране."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınındaki son deprem ve afetler ana ekranında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останні землетруси та лиха поруч із вами — на головному екрані."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے قریب تازہ ترین زلزلے اور آفات، ہوم اسکرین پر۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Động đất và thảm họa mới nhất gần bạn, ngay trên màn hình chính."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主屏幕上查看您附近的最新地震和灾害。"
          }
        }
      }
    },
