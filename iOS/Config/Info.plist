	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Crisis Connect</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Mirrors the export-compliance answer already on file with Apple for build 34
	     ("App Uses Non-Exempt Encryption: No"). Declaring it here rather than in App Store
	     Connect stops the questionnaire blocking every upload; the declaration itself is
	     unchanged. Revisit if the app ever ships crypto outside the published-standard /
	     mass-market exemption it relies on today. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.auralis.crisisconnect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-YOUR_GCM_SENDER_ID-ios-YOUR_APP_HASH</string>
				<string>com.googleusercontent.apps.YOUR_GCM_SENDER_ID-YOUR_CLIENT_ID_SUFFIX</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.auralis.crisisconnect.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>crisisconnect</string>
			</array>
		</dict>
	</array>
