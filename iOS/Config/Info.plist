	<true/>
	<key>CRISIS_CONNECT_WEB_URL</key>
	<string>https://crisis-connect-1.web.app</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MAPTILER_API_KEY</key>
	<string>SNhz0zyBetk9IYq2IosD</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth is used to find nearby contacts and exchange encrypted messages offline.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ccvoicechat._tcp</string>
		<string>_ccvoicechat._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Camera access is required to scan QR codes, use the rear flashlight, and power Night Vision obstacle awareness.</string>
	<key>NSContactsUsageDescription</key>
	<string>Crisis Connect matches your address book against its directory to find contacts who already use the app. Numbers are hashed for lookup and never stored.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Local network access is required to discover nearby iOS contacts and start encrypted voice calls.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Always-on location access keeps an active Breadcrumb Trail or rescue live-location session running when the screen is locked.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Always-on location access keeps an active Breadcrumb Trail or rescue live-location session running when the screen is locked.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location access centers offline maps, records your private Breadcrumb Trail for return guidance, and shares live position during SOS rescue coordination.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>BreadcrumbTrail</key>
		<string>Precise location is needed while Breadcrumb Trail is active so the recorded path can be retraced safely.</string>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone access is required to record and send voice messages and start nearby iOS voice calls.</string>
	<key>NSMotionUsageDescription</key>
	<string>Motion data is used to show device sensor readings.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition is used to dictate Crisis Sentinel field notes.</string>
