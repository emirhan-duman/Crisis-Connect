<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="qr_pairing_recovery.xml"/>
        <exclude domain="sharedpref" path="contact_access_consent.xml"/>
    <exclude domain="sharedpref" path="messaging_receipts.xml"/>
    <exclude domain="sharedpref" path="traffic_measurements.xml"/>
        <exclude domain="sharedpref" path="watch_commands_v1.xml"/>
        <exclude domain="sharedpref" path="watch_approval.xml"/>
        <exclude domain="sharedpref" path="sos_cloud_reporter.xml"/>
        <exclude domain="sharedpref" path="sos_contact_notifier.xml"/>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <!--
    <device-transfer>
        <exclude domain="sharedpref" path="qr_pairing_recovery.xml"/>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
    <device-transfer>
        <exclude domain="sharedpref" path="contact_access_consent.xml"/>
    <exclude domain="sharedpref" path="messaging_receipts.xml"/>
    <exclude domain="sharedpref" path="traffic_measurements.xml"/>
        <exclude domain="sharedpref" path="watch_commands_v1.xml"/>
        <exclude domain="sharedpref" path="watch_approval.xml"/>
        <exclude domain="sharedpref" path="sos_cloud_reporter.xml"/>
        <exclude domain="sharedpref" path="sos_contact_notifier.xml"/>
    </device-transfer>
</data-extraction-rules>
