    <string name="sensor_monitor_light_risk_low_comment">Die Sicht ist gering. Bewegen Sie sich vorsichtig und halten Sie Zusatzbeleuchtung bereit.</string>
    <string name="sensor_monitor_light_risk_detected_label">Licht erkannt</string>
    <string name="sensor_monitor_light_risk_detected_comment">Die vorhandene Beleuchtung reicht für die situative Sicht aus.</string>
