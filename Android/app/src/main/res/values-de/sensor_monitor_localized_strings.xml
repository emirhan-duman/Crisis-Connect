    <string name="sensor_monitor_pressure_risk_rising_comment">Der Druck steigt. Schnelle Wetterumschwünge sind möglich.</string>
    <string name="sensor_monitor_pressure_risk_normal_comment">Der Druck ist stabil und die Umweltbedingungen erscheinen beständig.</string>
    <string name="sensor_monitor_accelerometer_comment_unavailable">Die Beschleunigungsdaten konnten nicht gelesen werden.</string>
