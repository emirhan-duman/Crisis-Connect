    <string name="sensor_monitor_accelerometer_risk_normal_comment">Der Boden erscheint stabil, ohne nennenswertes Beben.</string>
    <string name="sensor_monitor_accelerometer_risk_warning_comment">Leichte Vibration erkannt. Überwachen Sie die Bedingungen in der Nähe weiterhin.</string>
    <string name="sensor_monitor_accelerometer_risk_danger_comment">Starke Beschleunigung erkannt. Begeben Sie sich sofort an einen sichereren Ort.</string>
    <string name="sensor_monitor_gyroscope_comment_unavailable">Die Rotationsdaten konnten nicht gelesen werden.</string>
    <string name="sensor_monitor_gyroscope_comment_live">Die Drehbewegung wird live in Radiant pro Sekunde angezeigt.</string>
