    <string name="sensor_monitor_pressure_comment_unavailable">Daneya pestoyê nehat xwendin.</string>
    <string name="sensor_monitor_pressure_comment_live">Pestoya atmosferê wek xwendineke hPa ya zindî tê nîşandan.</string>
    <string name="sensor_monitor_pressure_risk_falling_label">Pesto dadikeve</string>
    <string name="sensor_monitor_pressure_risk_falling_comment">Pesto dadikeve. Dibe ku metirsiya bahoz an hewaya giran zêde bibe.</string>
    <string name="sensor_monitor_pressure_risk_rising_label">Pesto bilind dibe</string>
    <string name="sensor_monitor_pressure_risk_rising_comment">Pesto bilind dibe. Guherînên hewayê yên bilez gengaz in.</string>
    <string name="sensor_monitor_pressure_risk_normal_comment">Pesto aram e û şert û mercên jîngehê aram xuya dikin.</string>
    <string name="sensor_monitor_accelerometer_comment_unavailable">Daneya lezê nehat xwendin.</string>
    <string name="sensor_monitor_accelerometer_comment_live">Livîna amûrê bi nirxên tewerê û g-force bi zindî tê nîşandan.</string>
    <string name="sensor_monitor_accelerometer_risk_normal_comment">Erd aram xuya dike û tu hejîna girîng tune.</string>
    <string name="sensor_monitor_accelerometer_risk_warning_comment">Hejîneke sivik hat tespîtkirin. Çavdêriya şert û mercên nêzîk bidomîne.</string>
    <string name="sensor_monitor_accelerometer_risk_danger_comment">Leza xurt hat tespîtkirin. Tavilê ber bi qadeke ewletir ve here.</string>
    <string name="sensor_monitor_gyroscope_comment_unavailable">Daneya zivirînê nehat xwendin.</string>
    <string name="sensor_monitor_gyroscope_comment_live">Livîna zivirînê bi radyan di çirkeyê de bi zindî tê nîşandan.</string>
    <string name="sensor_monitor_gyroscope_risk_normal_comment">Tu livîna zivirînê ya girîng nehat tespîtkirin.</string>
    <string name="sensor_monitor_gyroscope_risk_warning_comment">Zivirîn hat tespîtkirin. Piştrast bike ka livîn berdewam e.</string>
    <string name="sensor_monitor_gyroscope_risk_danger_comment">Zivirîna bilez hat tespîtkirin. Şoka mimkin an livîna bêîstiqrar binirxîne.</string>
    <string name="sensor_monitor_light_comment_unavailable">Asta ronahiya dorhêlê nehat pîvan.</string>
    <string name="sensor_monitor_light_comment_live">Ronahiya dorhêlê bi lux bi zindî tê nîşandan.</string>
    <string name="sensor_monitor_light_risk_dark_label">Tariya temam</string>
    <string name="sensor_monitor_light_risk_dark_comment">Qad bi tevahî tarî ye. Ji bo livîna ewle ronahiya zêde peyda bike.</string>
    <string name="sensor_monitor_light_risk_low_label">Ronahiya kêm</string>
    <string name="sensor_monitor_light_risk_low_comment">Xuyabûn kêm e. Bi baldarî bilive û ronahiya alîkar amade bike.</string>
    <string name="sensor_monitor_light_risk_detected_label">Ronahî hat tespîtkirin</string>
    <string name="sensor_monitor_light_risk_detected_comment">Ronahiya berdest ji bo xuyabûna rewşê bes e.</string>
    <string name="sensor_monitor_battery_title">Germahiya Bataryayê</string>
    <string name="sensor_monitor_battery_comment_unavailable">Germahiya bataryayê nehat pîvan.</string>
    <string name="sensor_monitor_battery_comment_live">Germahiya bataryayê bi derece Celsius bi zindî tê nîşandan.</string>
    <string name="sensor_monitor_battery_risk_normal_comment">Germahiya bataryayê di nav rêza ewle de ye.</string>
    <string name="sensor_monitor_battery_risk_warning_comment">Batarya germ dibe. Herika hewayê ya li dora amûrê baştir bike.</string>
    <string name="sensor_monitor_battery_risk_danger_comment">Germahiya bataryayê krîtîk e. Amûrê sar bike û tavilê bikaranînê kêm bike.</string>
