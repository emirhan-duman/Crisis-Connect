    <string name="sensor_monitor_gps_comment_permission_required">Ji bo nîşandana koordînatên GPS û dema GPS destûra cih pêwîst e.</string>
    <string name="sensor_monitor_gps_comment_disabled">GPS girtî ye, ji ber vê cih û dema GPS nayê xwendin.</string>
    <string name="sensor_monitor_gps_comment_not_supported">Ev amûr hardware ya GPS peyda nake.</string>
    <string name="sensor_monitor_gps_comment_searching">Hewl dide ku girêdana GPS bigire. Ji bo encamên zûtir ber bi qadeke ezmanvekirî ve here.</string>
    <string name="sensor_monitor_gps_comment_unavailable">Daneya GPS niha nayê xwendin.</string>
    <string name="sensor_monitor_gps_comment_waiting">Li benda daneya GPS.</string>
    <string name="sensor_monitor_gps_comment_live">Cihê GPS yê zindî, dem û hûrguliyên rastiyê li jêr tên nîşandan.</string>
    <string name="sensor_monitor_gps_title">Cih û Dema GPS</string>
