    <string name="sensor_monitor_risk_danger_label">Metirsî</string>
    <string name="sensor_monitor_gps_risk_accuracy_pending_label">Rastî li bendê</string>
    <string name="sensor_monitor_gps_risk_accuracy_pending_comment">Cih berdest e, li benda texmîneke rastiyê ya aram.</string>
    <string name="sensor_monitor_gps_risk_high_label">Rastiya bilind</string>
    <string name="sensor_monitor_gps_risk_high_comment">Girêdana GPS xurt e û ji bo hevrêzkirina qadê guncan e.</string>
    <string name="sensor_monitor_gps_risk_medium_label">Rastiya navîn</string>
    <string name="sensor_monitor_gps_risk_medium_comment">Cih bikêrhatî ye, lê berî biryarên krîtîk piştrast bike.</string>
    <string name="sensor_monitor_gps_risk_low_label">Rastiya nizm</string>
    <string name="sensor_monitor_gps_risk_low_comment">Şemitîna GPS bilind e. Di qadeke vekirîtir de ji nû ve kontrol bike.</string>
    <string name="sensor_monitor_gps_detail_accuracy_format">Rastî: +/- %1$d m</string>
    <string name="sensor_monitor_gps_detail_accuracy_missing">Rastî: nehat pîvan</string>
    <string name="sensor_monitor_gps_detail_altitude_format">Bilindahî: %1$.1f m</string>
