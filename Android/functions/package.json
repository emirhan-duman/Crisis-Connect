{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "verify:crisis-sentinel-storage": "node scripts/verify_crisis_sentinel_storage_release.mjs",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test scripts/test_attestation_exception_policy.mjs && node scripts/test_authority_mls_preparation.mjs && node scripts/test_authority_mls_preparation.property.js && npm run test:firestore-rules",
    "test:firestore-rules": "firebase emulators:exec --config ../firebase.json --project demo-crisis-connect --only firestore \"node --test scripts/test_firestore_rules.mjs\"",
    "test:authority-mls-preparation": "npm run build && node scripts/test_authority_mls_preparation.mjs",
    "test:property": "npm run build && node scripts/test_authority_mls_preparation.property.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/storage": "^8.1.0",
    "@peculiar/asn1-android": "^2.3.13",
    "@peculiar/asn1-schema": "^2.3.13",
    "@peculiar/x509": "^1.12.3",
    "cbor-x": "^1.6.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "fast-check": "^4.3.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.0",
    "rimraf": "^5.0.10",
    "typescript": "^7.0.2"
  },
  "private": true,
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "qs": "^6.16.0"
  }
}
