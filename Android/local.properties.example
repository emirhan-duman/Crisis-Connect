# Copy these keys into local.properties (Android Studio auto-generates `sdk.dir` there).
# local.properties is git-ignored; THIS .example file is safe to commit.
# Every key may alternatively be supplied as an environment variable of the same name (used by CI).
# Missing keys resolve to "" — see app/build.gradle.kts `secretConfigValue(...)`.

# --- REQUIRED: backend messaging / calls / sync ---
# Base URL of the deployed Crisis Connect web app (Next.js APIs live here).
# WITHOUT this, HierarchyMessagingClient.requireBaseUrl() throws
# "MOBILE_SYNC_BASE_URL is not configured" and ALL cross-panel (hierarchy) +
# agency messaging AND authority calls fail silently (the channel list shows
# "Kanallar yüklenemedi" / "Couldn't load channels").
MOBILE_SYNC_BASE_URL=https://crisisconnect.network
# This device's panel id for mobile sync.
MOBILE_SYNC_PANEL_ID=

# --- REQUIRED: sign-in / maps / App Check ---
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
MAPLIBRE_API_KEY=your_maplibre_api_key
APP_CHECK_DEBUG_TOKEN=your_app_check_debug_token

# --- OPTIONAL (have built-in defaults) ---
# ENTERPRISE_SSO_PROVIDER_ID=oidc.crisisconnect-sso
# RESCUE_NODE_ID_HEX_LENGTH=12
