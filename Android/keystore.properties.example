# Copy this file to keystore.properties and fill in real values.
# This file is safe to commit; keystore.properties is ignored by git.

# Relative path example: app/release-key.jks
# Absolute path example: /Users/yourname/keys/release-key.jks
STORE_FILE=app/release-key.jks
STORE_PASSWORD=change_me
KEY_ALIAS=release
KEY_PASSWORD=change_me

# Optional CI alternative (environment variables):
# ANDROID_KEYSTORE_FILE
# ANDROID_KEYSTORE_PASSWORD
# ANDROID_KEY_ALIAS
# ANDROID_KEY_PASSWORD
