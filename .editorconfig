root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts}]
indent_size = 4

[*.swift]
indent_size = 4

[*.{xml,json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{gradle,gradle.kts}]
indent_size = 4

[Makefile]
indent_style = tab
